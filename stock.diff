+    <!-- 49dip = exactly one list row, so a downward step scrolls by the same amount whether it is
+         consuming the Shuffle row or a track. It was a pinned 60 before, and for a while a 54 picked
+         so that 45 (status bar) + 54 + 16 (disc bar) + 5*49 (rows) came to exactly 360 — five whole
+         tracks and no sliver of a sixth, which is precisely what was wrong with it: with nothing
+         peeking out at the bottom edge there is no sign that the list goes on. -->
+    <com.innioasis.y1.view.ShufflePlaylistItemView android:id="@id/spv" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="49.0dip" app:layout_constraintTop_toTopOf="parent" />
