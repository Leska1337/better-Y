+  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
+    <!-- ipp: the ListView is declared FIRST here, unlike the other list screens, purely for draw
+         order — the disc bar below is PINNED and rows now pass under it (see Head), so it has to be
+         drawn after them. The visual order is unchanged: `spv` is still the top of the screen and
+         `ipp_disc_bar` still sits under it; both are placed by their constraints, not by this order,
